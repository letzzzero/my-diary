<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Вход</title>
    <link rel="stylesheet" href="/public/style.css" />
  </head>
  <body class="page">
    <div class="bg"></div>

    <main class="center">
      <div class="card auth">
        <div class="brand">
          <div class="logo">✦</div>
          <div>
            <h1 style="margin:0;">My Diary</h1>
            <p class="muted" style="margin:4px 0 0;">Личный дневник и цели</p>
          </div>
        </div>

        <% if (error) { %>
          <div class="notice error"><%= error %></div>
        <% } %>

        <form method="POST" action="/login" class="form" style="margin-top:10px;">
          <label>Логин</label>
          <input name="username" autocomplete="username" required />

          <label style="margin-top:10px;">Пароль</label>
          <input name="password" type="password" autocomplete="current-password" required />

          <button class="btn primary" type="submit" style="margin-top:14px; width:100%;">Войти</button>
        </form>

        <p class="muted" style="margin-top:10px;">
          Данные входа задаются в переменных окружения / <code>.env</code>.
        </p>
      </div>
    </main>

    <script src="/public/theme.js"></script>
  </body>
</html>
